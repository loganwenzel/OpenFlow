{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFlow",
  "version": "0.1.0",
  "identifier": "com.openflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenFlow",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "theme": "Dark"
      },
      {
        "label": "pill",
        "title": "OpenFlow Pill",
        "url": "index.html?window=pill",
        "width": 500,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "Apple Development: Samantha Kerry (WP6R5YWZLU)"
    }
  }
}
